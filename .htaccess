# Browsers must check with the server before reusing these files, so uploads take effect right away.
<FilesMatch "\.(html|js|css)$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# Short links for YouTube descriptions. They lead to the home page with tags
# that the stats page shows under "Campaign links":
#   /yt               -> utm_source=youtube, utm_campaign=channel
#   /yt/video-name    -> utm_source=youtube, utm_campaign=video-name
# Temporary (302) redirects, so browsers don't remember them if they change.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^yt/?$ /?utm_source=youtube&utm_campaign=channel [R=302,L,NC]
  RewriteRule ^yt/([A-Za-z0-9-]{1,60})/?$ /?utm_source=youtube&utm_campaign=$1 [R=302,L,NC]
</IfModule>
